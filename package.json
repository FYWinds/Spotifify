{
  "name": "spotifify",
  "version": "0.1.3",
  "type": "module",
  "description": "Idempotently sync Netease Cloud Music playlists and a local music library (incl. .ncm) to Spotify",
  "keywords": [
    "spotify",
    "netease",
    "netease-cloud-music",
    "ncm",
    "playlist",
    "sync",
    "local-files",
    "bun"
  ],
  "license": "MIT",
  "author": "FYWinds <i@fywinds.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FYWinds/Spotifify.git"
  },
  "homepage": "https://github.com/FYWinds/Spotifify#readme",
  "bugs": "https://github.com/FYWinds/Spotifify/issues",
  "engines": {
    "bun": ">=1.2"
  },
  "bin": {
    "spotifify": "./src/cli.ts"
  },
  "files": [
    "src",
    "scripts/register-task.ps1",
    "config.example.toml",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "spotifify": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0",
    "commander": "^14.0.0",
    "fastest-levenshtein": "^1.0.16",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "music-metadata": "^11.0.0",
    "opencc-js": "^1.0.5",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "smol-toml": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.0"
  }
}
